# ===================================================================
#  حَصاد AI — Hassad AI backend .gitignore
#  CRITICAL: `.env` MUST stay untracked so API keys are never pushed
#  to GitHub or any remote repository.
# ===================================================================

# --- Secrets & credentials (NEVER COMMIT) ---------------------------
.env
.env.*
!.env.example

# --- Private keys / certificates ------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
id_rsa*
id_ed25519*
secrets.*
credentials.*
*.keystore
*.jks

# --- Databases & local data -----------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
var/

# --- Uploaded images (privacy: never commit farmer photos) ----------
uploads/
media/
*.jpg
*.jpeg
*.png
*.webp
*.heic

# --- Python ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments -------------------------------------------
.venv/
venv/
env/
ENV/

# --- Test / type / lint caches --------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Editors & OS ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & local tooling -------------------------------------------
*.log
logs/
npm-debug.log*
.env.local
.env.*.local
