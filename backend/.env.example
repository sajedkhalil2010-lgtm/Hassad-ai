# Hassad AI - environment template
# Copy to `.env` and fill in your real key. NEVER commit `.env`.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_key_here

# --- optional model overrides -------------------------------------------
# Defaults live in agents/config.py and are verified against YOUR account
# at startup (run.py step [4/5]). Only set these if the preflight warns.
# A retired id returns HTTP 404 and the advisory/chat falls back or fails.
#
# CHAT_MODEL=openai/gpt-oss-120b
# ADVISOR_MODEL=openai/gpt-oss-120b
# VISION_MODEL=qwen/qwen3.8-27b
#
# NB: `llama-3.3-70b-versatile` does NOT work here - verified 404.

# --- local database & authentication ------------------------------------
# Accounts and sessions live in a SQLite file at backend/hassad.db
# (git-ignored). No third-party dependency: hashlib.scrypt for passwords,
# stdlib sqlite3 for storage.
#
# CHAT_MODEL overrides above are unrelated to auth; these control accounts:

# Who becomes an admin when they register. Admins may call /api/admin/users
# and see the "View registered users" button. Comma-separated, case-insensitive.
# An account that already exists is promoted on its next login, so editing
# this line is enough - no need to touch the database.
# ADMIN_EMAILS=you@example.com

# Session lifetime, in days. An older token is rejected on use.
# SESSION_TTL_DAYS=30

# Minimum password length. The real defence is the scrypt cost below; this
# is just the floor on what counts as a password at all.
# MIN_PASSWORD_LENGTH=8

# Brute-force throttle for /api/login: this many failures per email+IP within
# the window return HTTP 429 and a retry-after message.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300

# scrypt work factor. Memory is roughly 128*N*r bytes, so N=2**15 with r=8
# costs ~32 MiB and ~200 ms per verification. Raise it for stronger hardware:
# hashes record their own parameters, so raising it never signs anyone out.
# SCRYPT_N=32768
# SCRYPT_R=8
# SCRYPT_P=1

# Where the database file lives. A relative path resolves against backend/,
# so it lands next to main.py no matter how the server was started.
# DATABASE_PATH=hassad.db
