# Hassad AI - environment template
# Copy to `.env` and fill in your real key. NEVER commit `.env`.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_key_here

# --- optional model overrides -------------------------------------------
# Defaults live in agents/config.py and are verified against YOUR account
# at startup (run.py step [4/5]). Only set these if the preflight warns.
# A retired id returns HTTP 404 and the advisory/chat falls back or fails.
#
# CHAT_MODEL=openai/gpt-oss-120b
# ADVISOR_MODEL=openai/gpt-oss-120b
# VISION_MODEL=qwen/qwen3.8-27b
#
# NB: `llama-3.3-70b-versatile` does NOT work here - verified 404.
