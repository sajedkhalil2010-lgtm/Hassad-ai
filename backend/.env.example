# 1. SECRET KEY (كلمة سر عشوائية للتشفير والأمان)
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=put_your_secret_key_here

# 2. HUGGING FACE API KEY (مفتاح Hugging Face المجاني)
#    https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=put_your_huggingface_key_here

# 3. GEMINI API KEY (مفتاح Google Gemini المجاني)
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=put_your_gemini_key_here

# 4. CLOUD DATABASE URL (رابط قاعدة البيانات السحابية)
#    للعمل محلياً بدون سحابة، احذف السطر التالي واستخدم:
#    DATABASE_URL=sqlite+aiosqlite:///./hassad.db
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.xyz.supabase.co:5432/postgres
